---
/**
 * FastF1Section — Sección 05 del portfolio: Validación con datos reales.
 *
 * Layout:
 *   1. Section header (kicker / h2 / lead).
 *   2. Three-column comparison card (Bahrain / Barcelona / Monza). Each column
 *      shows a mini bar chart of model-vs-real pit stops + a quote + a ✓ badge.
 *   3. Footer note summarising the empirical contrast methodology.
 *
 * Bilingual via the `locale` prop. The interactive comparison is a React island
 * (client:visible) so it hydrates only when scrolled into view.
 */
import FastF1Comparison from '../interactive/FastF1Comparison';
import validationRaw from '../../data/fastf1_validation.json';

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;

// Narrow the JSON once. The sampling script guarantees the shape; TypeScript
// is happy after the explicit cast.
type ValidationCircuit = {
  id: 'barcelona' | 'bahrain' | 'monza';
  name: string;
  country_es: string;
  country_en: string;
  length_km: number;
  turns: number;
  downforce_level: string;
  lap_time_baseline_s: number;
  model: {
    predicted_stops: number;
    predicted_window_laps: [number, number];
    predicted_compounds: string[];
    predicted_total_stint_laps: number;
    completion_pct: number;
    avg_reward: number;
  };
  real: {
    actual_stops: number;
    typical_window_laps: [number, number];
    common_compounds: string[];
    reference_team: string;
    notes: string;
    lap_times: {
      soft: { best_s: number; avg_s: number; final_wear_pct: number; laps_completed: number };
      medium: { best_s: number; avg_s: number; final_wear_pct: number; laps_completed: number };
      hard: { best_s: number; avg_s: number; final_wear_pct: number; laps_completed: number };
    };
  };
  validation: {
    stops_match: boolean;
    compounds_match: boolean;
    window_overlap_pct: number;
    confidence: number;
    match_class: 'full' | 'partial' | 'miss';
    grid_pattern_es: string;
    grid_pattern_en: string;
    quote_es: string;
    quote_en: string;
  };
};

type MethodologyCopy = {
  title: string;
  intro: string;
  stops_match: string;
  compounds_match: string;
  window_overlap_pct: string;
  confidence: string;
  match_class_label: string;
  match_class_full: string;
  match_class_partial: string;
  match_class_miss: string;
  limitations: string;
};

type ValidationPayload = {
  circuits: ValidationCircuit[];
  footer: { es: string; en: string };
  methodology: { es: MethodologyCopy; en: MethodologyCopy };
};

const methodologyCopy =
  (validationRaw as unknown as ValidationPayload).methodology[locale];

const validationData = validationRaw as unknown as ValidationPayload;

const content = {
  es: {
    kicker: '// 05 — VALIDACIÓN CON DATOS REALES',
    title: 'Bahrain, Barcelona, Monza\n—validado en pista',
    lead: 'Los datos reales de F1 validan el modelo. No es simulación, es contraste empírico: las paradas que el agente decide caen dentro de las ventanas que los equipos reales ejecutaron en cada Gran Premio.',
    footer: validationData.footer.es,
  },
  en: {
    kicker: '// 05 — REAL-DATA VALIDATION',
    title: 'Bahrain, Barcelona, Monza\n—validated on track',
    lead: 'Real F1 data validates the model. This is not simulation, it is empirical contrast: the agent\u2019s pit decisions fall inside the windows that real teams executed at each Grand Prix.',
    footer: validationData.footer.en,
  },
}[locale];

const titleLines = content.title.split('\n');
---

<section
  id="fastf1"
  class="fastf1-section"
  data-section="fastf1"
  aria-labelledby="fastf1-title"
>
  <div class="fastf1-section__container">
    <!-- Header -->
    <header class="fastf1-section__head">
      <span class="fastf1-section__kicker reveal" style="--reveal-delay: 0ms">
        {content.kicker}
      </span>
      <h2
        id="fastf1-title"
        class="fastf1-section__title reveal"
        style="--reveal-delay: 60ms"
      >
        {titleLines.map((line) => (
          <span class="fastf1-section__title-line">{line}</span>
        ))}
      </h2>
      <p
        class="fastf1-section__lead reveal"
        style="--reveal-delay: 140ms"
      >
        {content.lead}
      </p>
    </header>

    <!-- Three-column comparison -->
    <div class="fastf1-section__grid reveal" style="--reveal-delay: 240ms">
      <FastF1Comparison client:visible locale={locale} data={validationData} />
    </div>

    <!-- Methodology legend — defines every metric so the numbers above
         aren't read in a vacuum. <details>/<summary> keeps the block
         collapsed by default (saves scroll) but available to a curious
         recruiter / strategy engineer who clicks through. -->
    <details class="fastf1-section__methodology reveal" style="--reveal-delay: 320ms">
      <summary class="fastf1-section__methodology-summary">
        <span class="fastf1-section__methodology-kicker">// 05.1 — METODOLOGÍA</span>
        <span class="fastf1-section__methodology-title">{methodologyCopy.title}</span>
      </summary>
      <div class="fastf1-section__methodology-body">
        <p class="fastf1-section__methodology-intro">{methodologyCopy.intro}</p>
        <dl class="fastf1-section__methodology-list">
          <div>
            <dt>stops_match</dt>
            <dd>{methodologyCopy.stops_match}</dd>
          </div>
          <div>
            <dt>compounds_match</dt>
            <dd>{methodologyCopy.compounds_match}</dd>
          </div>
          <div>
            <dt>window_overlap_pct</dt>
            <dd>{methodologyCopy.window_overlap_pct}</dd>
          </div>
          <div>
            <dt>confidence</dt>
            <dd>{methodologyCopy.confidence}</dd>
          </div>
        </dl>
        <p class="fastf1-section__methodology-classes">
          <strong>{methodologyCopy.match_class_label}</strong>
          <span class="fastf1-section__methodology-class is-full">{methodologyCopy.match_class_full}</span>
          <span class="fastf1-section__methodology-class is-partial">{methodologyCopy.match_class_partial}</span>
          <span class="fastf1-section__methodology-class is-miss">{methodologyCopy.match_class_miss}</span>
        </p>
        <p class="fastf1-section__methodology-limitation">{methodologyCopy.limitations}</p>
      </div>
    </details>

    <!-- Footer note -->
    <p class="fastf1-section__footer reveal" style="--reveal-delay: 420ms">
      {content.footer}
    </p>
  </div>
</section>

<script>
  /**
   * Reveal-on-scroll — same pattern as StrategyDataSection. When the section
   * enters the viewport, every child with the .reveal class gets
   * .is-visible. Stagger is driven by the inline --reveal-delay.
   */
  const init = () => {
    const section = document.querySelector<HTMLElement>('[data-section="fastf1"]');
    if (!section) return;

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reveals = section.querySelectorAll<HTMLElement>('.reveal');

    if (reducedMotion) {
      reveals.forEach((el) => el.classList.add('is-visible'));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const target = entry.target as HTMLElement;
          target.classList.add('is-visible');
          target.querySelectorAll<HTMLElement>('.reveal').forEach((el, idx) => {
            const delayVar = parseFloat(el.style.getPropertyValue('--reveal-delay')) || idx * 80;
            window.setTimeout(() => el.classList.add('is-visible'), delayVar);
          });
          observer.unobserve(target);
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
    );
    observer.observe(section);
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>

<style>
  /* ============================================================================
   * FastF1Section — header → 3-column comparison → footer
   * ========================================================================= */
  .fastf1-section {
    position: relative;
    padding: var(--section-padding-y) var(--space-5);
    background:
      radial-gradient(
        ellipse 60% 50% at 50% 0%,
        rgba(168, 216, 0, 0.08) 0%,
        transparent 70%
      ),
      linear-gradient(180deg, var(--ink) 0%, var(--ink-2) 100%);
    scroll-margin-top: 96px;
  }

  @media (min-width: 768px) {
    .fastf1-section {
      padding: var(--section-padding-y) var(--space-8);
    }
  }

  .fastf1-section__container {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  /* Header ------------------------------------------------------------------- */
  .fastf1-section__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    max-width: 64ch;
  }

  .fastf1-section__kicker {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-brand);
    line-height: var(--leading-normal);
  }

  .fastf1-section__title {
    font-family: var(--font-display);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: var(--tracking-tight);
    color: var(--color-fg);
    margin: 0;
    font-size: clamp(2rem, 4vw, 3rem);
  }

  .fastf1-section__title-line {
    display: block;
  }

  .fastf1-section__lead {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
  }

  /* Grid wrapper ------------------------------------------------------------- */
  .fastf1-section__grid {
    background: var(--primary);
    border: 1px solid var(--rule);
    border-radius: var(--radius-lg);
    padding: var(--space-5);
  }

  @media (min-width: 768px) {
    .fastf1-section__grid {
      padding: var(--space-6);
    }
  }

  /* Footer ------------------------------------------------------------------- */
  .fastf1-section__footer {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--color-fg-muted);
    text-align: center;
    max-width: 60ch;
    margin: 0 auto;
    border-top: 1px solid var(--rule);
    padding-top: var(--space-5);
  }

  /* Methodology legend ------------------------------------------------------
   * Defines every metric in the validation cards so a strategy engineer /
   * recruiter reading the page top-to-bottom can decode the numbers
   * (confidence, window_overlap_pct, match_class) without leaving the
   * site. <details>/<summary> keeps it collapsed by default — it expands
   * on click and stays open across navigations. */
  .fastf1-section__methodology {
    margin: 0 auto;
    max-width: 760px;
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    background: rgba(255, 255, 255, 0.02);
    overflow: hidden;
  }

  .fastf1-section__methodology-summary {
    list-style: none;
    cursor: pointer;
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    transition: background var(--motion-duration-short) var(--motion-ease-out);
  }
  .fastf1-section__methodology-summary::-webkit-details-marker {
    display: none;
  }
  .fastf1-section__methodology-summary::after {
    content: '+ Definir métricas';
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-brand);
    align-self: flex-start;
    margin-top: var(--space-1);
  }
  details[open] .fastf1-section__methodology-summary::after {
    content: '− Ocultar';
  }
  .fastf1-section__methodology-summary:hover {
    background: rgba(168, 216, 0, 0.04);
  }

  .fastf1-section__methodology-kicker {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-brand);
  }

  .fastf1-section__methodology-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-md);
    color: var(--color-fg);
    letter-spacing: var(--tracking-snug);
  }

  .fastf1-section__methodology-body {
    padding: var(--space-3) var(--space-5) var(--space-5);
    border-top: 1px solid var(--rule);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .fastf1-section__methodology-intro,
  .fastf1-section__methodology-limitation {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
    margin: 0;
  }

  .fastf1-section__methodology-list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
    margin: 0;
  }
  @media (min-width: 720px) {
    .fastf1-section__methodology-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .fastf1-section__methodology-list > div {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--space-3);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
  }
  .fastf1-section__methodology-list dt {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-brand);
    margin: 0;
  }
  .fastf1-section__methodology-list dd {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-fg);
    margin: 0;
  }

  .fastf1-section__methodology-classes {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-3);
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
  }
  .fastf1-section__methodology-classes strong {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-fg-muted);
    font-weight: 500;
  }
  .fastf1-section__methodology-class {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
    display: flex;
    gap: 8px;
    align-items: baseline;
  }
  /* Mirror the badge colours in the methodology legend so a reader
     recognises the palette consistently. */
  .fastf1-section__methodology-class.is-full { color: var(--color-highlight); }
  .fastf1-section__methodology-class.is-partial { color: #e6b94d; }
  .fastf1-section__methodology-class.is-miss { color: var(--color-fg-muted); }

  /* ============================================================================
   * Reveal animation — same pattern as StrategySection
   * ========================================================================= */
  .reveal {
    opacity: 0;
    transform: translateY(20px);
    transition:
      opacity var(--motion-duration-long) var(--motion-ease-out),
      transform var(--motion-duration-long) var(--motion-ease-out);
    will-change: opacity, transform;
  }

  .is-visible.reveal {
    opacity: 1;
    transform: translateY(0);
  }

  @media (prefers-reduced-motion: reduce) {
    .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
