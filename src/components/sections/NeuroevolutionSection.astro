---
/**
 * NeuroevolutionSection — Sección 03 (STAR) del portfolio.
 *
 * Cuenta la historia del entrenamiento evolutivo. Estructura:
 *
 *   1. Headline cinematográfico: 124.0 → 66.0 con flecha SVG animada
 *   2. "Tres dimensiones del aprendizaje"
 *      - Survival time (s aprender a NO chocar)
 *      - Laps per stint (s aprender a gestionar neumáticos)
 *      - Best lap time (la mejora clásica 124→66)
 *      Tres sub-charts uno al lado del otro en desktop, apilados en móvil.
 *   3. Tres razones por las que se eligió neuroevolución sobre PPO
 *   4. Diagrama de arquitectura del controlador (isla React)
 */
import GenerationTimeline from '../interactive/GenerationTimeline';
import NNDiagram from '../interactive/NNDiagram';
import LearningChart from '../interactive/LearningChart';
import type { MetricSpec } from '../interactive/LearningChart';

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;

const content = {
  es: {
    kicker: '// 03 — CONDUCCIÓN AUTÓNOMA',
    titleLines: ['Neuroevolución:', '124s → 66s'],
    subtitle:
      '98 generaciones · −46.8% por vuelta · tres dimensiones de aprendizaje simultáneas',
    threeDim: {
      kicker: '// 03.1 — TRES DIMENSIONES DEL APRENDIZAJE',
      title: 'Lo que el agente tuvo que aprender (no solo ir más rápido)',
      intro:
        'Minimizar el tiempo por vuelta es el objetivo final, pero el agente tuvo que descubrir tres cosas en paralelo. Sobrevivir antes que acelerar. Conservar neumáticos antes que firmar vuelta rápida. Y solo entonces, hilar fino en cada curva.',
      blocks: {
        survival: {
          kicker: 'Aprender a conducir',
          caption:
            'Generación 1 sobrevive ~1 segundo antes de chocar. A partir de la 25 ya completa una vuelta.',
        },
        stint: {
          kicker: 'Aprender a gestionar neumáticos',
          caption:
            'Vueltas completadas por stint sin parar. La gestión emerge tarde — el desgaste se paga solo al final.',
        },
        lap: {
          kicker: 'Aprender a ser rápido',
          caption:
            'La métrica clásica: vuelta rápida media por generación. 124s → 66s en 98 generaciones.',
        },
      },
    },
    reasonsTitle: 'Por qué neuroevolución y no PPO',
    nnTitle: 'Arquitectura del controlador',
    reasons: [
      {
        num: '01',
        title: 'Arquitectura compacta',
        body: '~5.000 parámetros donde PPO no aporta. Sin gradientes, sin replay buffer. Cada red es una solución completa y evaluable de forma independiente.',
      },
      {
        num: '02',
        title: 'Robusto a óptimos locales',
        body: 'El agente debe aprender a NO chocar, no a maximizar reward. La presión evolutiva evita la trampa de quedarse quieto para sobrevivir.',
      },
      {
        num: '03',
        title: 'Paralelización masiva',
        body: '100 individuos evaluados en paralelo por generación. Inferencia rápida (forward pass de 25K params). CPU utilization 100%.',
      },
    ],
  },
  en: {
    kicker: '// 03 — AUTONOMOUS DRIVING',
    titleLines: ['Neuroevolution:', '124s → 66s'],
    subtitle:
      '98 generations · −46.8% per lap · three simultaneous dimensions of learning',
    threeDim: {
      kicker: '// 03.1 — THREE DIMENSIONS OF LEARNING',
      title: 'What the agent had to learn (not just go faster)',
      intro:
        'Minimising lap time is the final objective, but the agent had to discover three things in parallel. Survive before accelerating. Conserve tyres before signing a fast lap. And only then, fine-tune every corner.',
      blocks: {
        survival: {
          kicker: 'Learning to drive',
          caption:
            'Generation 1 survives ~1 second before crashing. By generation 25 it already completes a lap.',
        },
        stint: {
          kicker: 'Learning tyre management',
          caption:
            'Laps completed per stint without pitting. This emerges late — wear only bites you at the end.',
        },
        lap: {
          kicker: 'Learning to be fast',
          caption:
            'The classic metric: average fastest lap per generation. 124s → 66s over 98 generations.',
        },
      },
    },
    reasonsTitle: 'Why neuroevolution over PPO',
    nnTitle: 'Controller architecture',
    reasons: [
      {
        num: '01',
        title: 'Compact architecture',
        body: '~5,000 parameters where PPO adds no value. No gradients, no replay buffer. Each network is a complete, independently evaluable solution.',
      },
      {
        num: '02',
        title: 'Robust to local optima',
        body: 'The agent must learn NOT to crash, not to maximize reward. Evolutionary pressure avoids the trap of staying still to survive.',
      },
      {
        num: '03',
        title: 'Massive parallelization',
        body: '100 individuals evaluated in parallel per generation. Fast inference (25K-param forward pass). 100% CPU utilization.',
      },
    ],
  },
}[locale];

const reasons = content.reasons;

// Each chart's MetricSpec — built server-side so the static HTML carries
// the bilingual labels and the React island only has to render.
const survivalSpec: MetricSpec = {
  title: locale === 'es' ? 'Supervivencia' : 'Survival time',
  caption: content.threeDim.blocks.survival.caption,
  yAxisLabel: locale === 'es' ? 'Segundos antes de chocar' : 'Seconds before crash',
  unit: 's',
  key: 'survival_s',
  yMin: 0,
  yMax: 90,
  yTicks: [0, 20, 40, 60, 80],
  variant: 'saffron',
  betterDirection: 'higher',
  decimals: 0,
};

const stintSpec: MetricSpec = {
  title: locale === 'es' ? 'Vueltas por stint' : 'Laps per stint',
  caption: content.threeDim.blocks.stint.caption,
  yAxisLabel: locale === 'es' ? 'Vueltas completadas' : 'Laps completed',
  unit: ' v',
  key: 'laps_completed',
  yMin: 0,
  yMax: 50,
  yTicks: [0, 10, 20, 30, 40, 50],
  variant: 'racing',
  betterDirection: 'higher',
  decimals: 0,
};

const lapSpec: MetricSpec = {
  title: locale === 'es' ? 'Vuelta rápida' : 'Fastest lap',
  caption: content.threeDim.blocks.lap.caption,
  yAxisLabel: locale === 'es' ? 'Vuelta (s)' : 'Lap (s)',
  unit: 's',
  key: 'best_lap_s',
  secondaryKey: 'avg_lap_s',
  yMin: 60,
  yMax: 140,
  yTicks: [60, 80, 100, 120, 140],
  variant: 'persimmon',
  betterDirection: 'lower',
  decimals: 0,
};
---

<section id="neuroevolution" class="neuro-section" data-section="neuroevolution" aria-labelledby="neuro-title">
  <div class="neuro-section__inner">
    <!-- ============================================================== -->
    <!-- Part 1 — Headline                                                -->
    <!-- ============================================================== -->
    <header class="neuro-section__header">
      <span class="neuro-section__kicker">{content.kicker}</span>
      <h2 id="neuro-title" class="neuro-section__title">
        {content.titleLines.map((line) => (
          <span class="neuro-section__title-line">{line}</span>
        ))}
      </h2>
    </header>

    <div class="neuro-headline" aria-hidden="true">
      <div class="neuro-headline__num neuro-headline__num--start">
        <span class="neuro-headline__value">124.0</span>
        <span class="neuro-headline__unit">s</span>
      </div>

      <svg
        class="neuro-headline__arrow"
        viewBox="0 0 220 32"
        preserveAspectRatio="none"
        role="presentation"
      >
        <line
          x1="4"
          y1="16"
          x2="200"
          y2="16"
          stroke="var(--accent)"
          stroke-width="1.5"
          stroke-dasharray="6 4"
          vector-effect="non-scaling-stroke"
        />
        <polygon
          points="200,8 216,16 200,24"
          fill="var(--accent)"
        />
      </svg>

      <div class="neuro-headline__num neuro-headline__num--end">
        <span class="neuro-headline__value">66.0</span>
        <span class="neuro-headline__unit">s</span>
      </div>
    </div>

    <p class="neuro-section__subtitle">{content.subtitle}</p>

    <!-- ============================================================== -->
    <!-- Part 2 — Three dimensions of learning                            -->
    <!-- ============================================================== -->
    <div class="neuro-three-dim">
      <div class="neuro-three-dim__head">
        <span class="neuro-three-dim__kicker">{content.threeDim.kicker}</span>
        <h3 class="neuro-three-dim__title">{content.threeDim.title}</h3>
        <p class="neuro-three-dim__intro">{content.threeDim.intro}</p>
      </div>

      <div class="neuro-three-dim__charts">
        <article class="neuro-dim-chart" data-variant="saffron">
          <div class="neuro-dim-chart__head">
            <span class="neuro-dim-chart__kicker">
              {content.threeDim.blocks.survival.kicker}
            </span>
            <h4 class="neuro-dim-chart__heading">{survivalSpec.title}</h4>
          </div>
          <div class="neuro-dim-chart__canvas">
            <LearningChart client:visible locale={locale} spec={survivalSpec} />
          </div>
          <p class="neuro-dim-chart__caption">{survivalSpec.caption}</p>
        </article>

        <article class="neuro-dim-chart" data-variant="racing">
          <div class="neuro-dim-chart__head">
            <span class="neuro-dim-chart__kicker">
              {content.threeDim.blocks.stint.kicker}
            </span>
            <h4 class="neuro-dim-chart__heading">{stintSpec.title}</h4>
          </div>
          <div class="neuro-dim-chart__canvas">
            <LearningChart client:visible locale={locale} spec={stintSpec} />
          </div>
          <p class="neuro-dim-chart__caption">{stintSpec.caption}</p>
        </article>

        <article class="neuro-dim-chart" data-variant="persimmon">
          <div class="neuro-dim-chart__head">
            <span class="neuro-dim-chart__kicker">
              {content.threeDim.blocks.lap.kicker}
            </span>
            <h4 class="neuro-dim-chart__heading">{lapSpec.title}</h4>
          </div>
          <div class="neuro-dim-chart__canvas">
            <GenerationTimeline client:visible locale={locale} />
          </div>
          <p class="neuro-dim-chart__caption">{lapSpec.caption}</p>
        </article>
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- Part 3 — Reasons                                                 -->
    <!-- ============================================================== -->
    <div class="neuro-block">
      <h3 class="neuro-block__title">{content.reasonsTitle}</h3>
      <div class="neuro-reasons" role="list">
        {reasons.map((r) => (
          <article class="neuro-reason" role="listitem">
            <span class="neuro-reason__num">{r.num}</span>
            <h4 class="neuro-reason__title">{r.title}</h4>
            <p class="neuro-reason__body">{r.body}</p>
          </article>
        ))}
      </div>
    </div>

    <!-- ============================================================== -->
    <!-- Part 4 — NN Diagram                                              -->
    <!-- ============================================================== -->
    <div class="neuro-block">
      <h3 class="neuro-block__title">{content.nnTitle}</h3>
      <div class="neuro-block__nn">
        <NNDiagram client:visible locale={locale} />
      </div>
    </div>
  </div>
</section>

<style is:global>
  /* ==========================================================================
     NeuroevolutionSection — global styles so the React islands
     (LearningChart + GenerationTimeline + NNDiagram) can be styled from
     the section's CSS. All values come from tokens.css.
     ========================================================================== */

  .neuro-section {
    position: relative;
    padding: var(--section-padding-y) var(--space-5);
    border-top: var(--border-thin);
    scroll-margin-top: 96px;
  }

  .neuro-section__inner {
    max-width: 1100px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  /* ---- Header ----------------------------------------------------------- */
  .neuro-section__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 880px;
  }

  .neuro-section__kicker {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-brand);
  }

  .neuro-section__title {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-tight);
    color: var(--color-fg);
    margin: 0;
    font-size: clamp(2rem, 5vw, 3.5rem);
  }

  .neuro-section__title-line {
    display: block;
  }

  /* ---- Headline (124 → 66) --------------------------------------------- */
  .neuro-headline {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-6);
    padding: var(--space-6) var(--space-4);
    background: linear-gradient(180deg, var(--primary) 0%, var(--ink-2) 100%);
    border: var(--border-default);
    border-radius: var(--radius-lg);
    /* 2026-09-21: numbers + arrow used to overflow on phones because
       the parent was a non-wrapping flex row. Wrap so the arrow drops to
       its own line when the row is too tight. */
    flex-wrap: wrap;
    row-gap: var(--space-3);
  }

  .neuro-headline__num {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-display);
    font-variant-numeric: tabular-nums;
    line-height: 1;
    /* Natural sizing on the numbers (no flex-grow). Only the arrow grows
       to fill the gap between them, so the row sits centered and the two
       numbers anchor against the arrow at their natural width. */
    flex: 0 0 auto;
  }

  .neuro-headline__num--start .neuro-headline__value {
    color: var(--text-dim);
    opacity: 0.55;
  }

  .neuro-headline__num--end .neuro-headline__value {
    color: var(--accent);
    text-shadow: 0 0 16px rgba(255, 91, 58, 0.45);
  }

  .neuro-headline__value {
    font-weight: 600;
    /* 2026-09-21: floor lowered from 3.5rem to 2rem so phones (<640px) read
       the numbers in a single line; ceiling stays at 5.5rem. */
    font-size: clamp(2rem, 9vw, 5.5rem);
    letter-spacing: var(--tracking-snug);
  }

  .neuro-headline__unit {
    /* Floor lowered from 1.5rem to 1.1rem to track the value scale. */
    font-size: clamp(1.1rem, 4vw, 2.25rem);
    color: var(--text-dim);
    font-weight: 500;
  }

  .neuro-headline__arrow {
    /* flex-basis: 0 → the arrow grows from zero to fill whatever the
       numbers + gaps leave behind, instead of starting from its
       intrinsic SVG size (which is browser-dependent and creates the
       asymmetric left/right whitespace the user reported). */
    flex: 1 1 0%;
    height: 32px;
    min-width: 96px;
    max-width: 320px;
    overflow: visible;
    animation: neuro-headline-arrow-dash 1.4s linear infinite;
    /* Natural DOM order (124 → arrow → 66) keeps the arrow between the
       two numbers on desktop. `order` is reserved for the mobile break
       below, where it must drop to its own row. */
  }

  /* Narrow phones — let the arrow drop to its own row instead of trying
     to squeeze between two big numbers. */
  @media (max-width: 520px) {
    .neuro-headline {
      gap: var(--space-4);
    }
    /* Push the arrow to the end of the flex line so it wraps to its
       own row after the two numbers. */
    .neuro-headline__arrow {
      order: 3;
      flex-basis: 100%;
      max-width: none;
      height: 24px;
    }
  }

  @keyframes neuro-headline-arrow-dash {
    to {
      stroke-dashoffset: -20;
    }
  }

  .neuro-section__subtitle {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
    text-align: center;
    margin: 0;
  }

  /* ---- Three dimensions block ------------------------------------------ */
  .neuro-three-dim {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .neuro-three-dim__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 64ch;
  }

  .neuro-three-dim__kicker {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-brand);
  }

  .neuro-three-dim__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--color-fg);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    margin: 0;
  }

  .neuro-three-dim__intro {
    font-family: var(--font-body);
    font-size: var(--text-base);
    color: var(--color-fg-muted);
    line-height: var(--leading-relaxed);
    margin: 0;
    max-width: 60ch;
  }

  .neuro-three-dim__charts {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 900px) {
    .neuro-three-dim__charts {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--space-4);
    }
  }

  .neuro-dim-chart {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--ink);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    border-top: 2px solid var(--color-fg-muted);
    transition: border-color var(--motion-duration-short) var(--motion-ease-out);
  }

  .neuro-dim-chart[data-variant="persimmon"] {
    border-top-color: var(--accent);
  }

  .neuro-dim-chart[data-variant="saffron"] {
    border-top-color: var(--secondary);
  }

  .neuro-dim-chart[data-variant="racing"] {
    border-top-color: var(--asphalt);
  }

  .neuro-dim-chart__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .neuro-dim-chart__kicker {
    font-family: var(--font-display);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--text-dim);
  }

  .neuro-dim-chart__heading {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-fg);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    margin: 0;
  }

  .neuro-dim-chart__canvas {
    width: 100%;
  }

  .neuro-dim-chart__caption {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
    margin: 0;
  }

  /* ---- Block (Reasons / NN diagram) ----------------------------------- */
  .neuro-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .neuro-block__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-lg);
    color: var(--color-fg);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    margin: 0;
    padding-bottom: var(--space-3);
    border-bottom: var(--border-thin);
  }

  .neuro-block__nn {
    width: 100%;
    background: var(--ink);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    padding: var(--space-5) var(--space-4);
  }

  /* ---- Reason cards ---------------------------------------------------- */
  .neuro-reasons {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .neuro-reasons {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .neuro-reason {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5);
    background: var(--primary);
    border: var(--border-default);
    border-radius: var(--radius-md);
    transition:
      transform var(--motion-duration-short) var(--motion-ease-out),
      border-color var(--motion-duration-short) var(--motion-ease-out),
      box-shadow var(--motion-duration-short) var(--motion-ease-out);
  }

  .neuro-reason:hover,
  .neuro-reason:focus-within {
    transform: translateY(-4px);
    border-color: var(--secondary);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.35);
  }

  .neuro-reason__num {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    color: var(--accent);
    letter-spacing: var(--tracking-tight);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .neuro-reason__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-md);
    color: var(--color-fg);
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-snug);
    margin: 0;
  }

  .neuro-reason__body {
    font-family: var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
    margin: 0;
  }

  /* ---- Responsive ----------------------------------------------------- */
  @media (max-width: 640px) {
    .neuro-section {
      padding: var(--space-10) var(--space-4);
    }

    .neuro-headline {
      gap: var(--space-3);
      padding: var(--space-4) var(--space-3);
    }

    .neuro-headline__arrow {
      min-width: 60px;
      max-width: 120px;
    }
  }
</style>
