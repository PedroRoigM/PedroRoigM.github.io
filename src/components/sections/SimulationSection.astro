---
/**
 * SimulationSection — Sección 02 del portfolio.
 *
 * Grid interactivo de los 5 circuitos de F1 que el simulador renderiza
 * (Barcelona, Mónaco, Monza, Spa, Silverstone). Cada circuito es una
 * "mini-mapa SVG" con un dot que recorre el trazado en loop. Hover
 * acelera el dot y muestra stats. Click abre un modal fullscreen con
 * slider de scrub manual.
 *
 * Arquitectura:
 * - Esta sección es un shell Astro (HTML + estilos globales scoped).
 * - `CircuitGrid` y `CircuitModal` son islas React (`client:visible`).
 * - El estado del modal vive en un wrapper React (`SimulationInteractive`)
 *   porque Astro no puede compartir estado entre dos islas.
 */
import circuits from '../../data/circuits';
import SimulationInteractive from '../interactive/SimulationInteractive';

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;

const content = {
  es: {
    kicker: '// 02 — SIMULACIÓN DEL CIRCUITO',
    titleLines: ['Cinco circuitos,', 'once rayos sensor'],
    lead:
      'El simulador renderiza cada circuito con checkpoints definidos. Once rayos sensor detectan obstáculos a 50 Hz sobre la geometría del trazado. Cuatro niveles de curriculum llevan al agente de "sin límites de grip" hasta física realista con deslizamiento, subviraje y Círculo de Tracción.',
    stats: ['5 circuitos', '11 rayos sensor', '50 Hz simulación', '4.7–7.0 km', '98 generaciones'],
  },
  en: {
    kicker: '// 02 — CIRCUIT SIMULATION',
    titleLines: ['Five circuits,', 'eleven sensor rays'],
    lead:
      'The simulator renders each track with defined checkpoints. Eleven sensor rays detect obstacles at 50 Hz over the track geometry. Four curriculum levels take the agent from "no grip limits" to realistic physics with slip, understeer and Traction Circle.',
    stats: ['5 circuits', '11 sensor rays', '50 Hz simulation', '4.7–7.0 km', '98 generations'],
  },
}[locale];

const stats = content.stats;
---

<section class="sim-section" data-section="simulation" aria-labelledby="sim-title">
  <div class="sim-section__inner">
    <header class="sim-section__header">
      <span class="sim-section__kicker">{content.kicker}</span>
      <h2 id="sim-title" class="sim-section__title">
        {content.titleLines.map((line) => (
          <span class="sim-section__title-line">{line}</span>
        ))}
      </h2>
      <p class="sim-section__lead">{content.lead}</p>
    </header>

    <div class="sim-stats" role="list" aria-label={locale === 'es' ? 'Estadísticas del simulador' : 'Simulator stats'}>
      {stats.map((stat, idx) => (
        <span class="sim-stats__item" role="listitem">
          <span class="sim-stats__text">{stat}</span>
          {idx < stats.length - 1 && <span class="sim-stats__sep" aria-hidden="true">·</span>}
        </span>
      ))}
    </div>

    <SimulationInteractive client:visible circuits={circuits} locale={locale} />
  </div>
</section>

<style is:global>
  /* ==========================================================================
     SimulationSection — global styles so the React islands (CircuitGrid +
     CircuitModal) can be styled from the section's CSS.
     All values come from tokens.css — no hardcoded hex, ms, or easings.
     ========================================================================== */

  .sim-section {
    position: relative;
    padding: var(--section-padding-y) var(--space-5);
    border-top: var(--border-thin);
  }

  .sim-section__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* ---- Header ------------------------------------------------------------- */
  .sim-section__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 880px;
  }

  .sim-section__kicker {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-brand);
  }

  .sim-section__title {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-tight);
    color: var(--color-fg);
    margin: 0;
    font-size: clamp(1.75rem, 4vw, var(--text-2xl));
  }

  .sim-section__title-line {
    display: block;
  }

  .sim-section__lead {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
    max-width: 64ch;
  }

  @media (min-width: 768px) {
    .sim-section__lead {
      font-size: var(--text-md);
    }
  }

  /* ---- Stats panel -------------------------------------------------------- */
  .sim-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-4) 0;
    border-top: var(--border-thin);
    border-bottom: var(--border-thin);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-fg);
  }

  .sim-stats__item {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .sim-stats__text {
    font-weight: 500;
  }

  .sim-stats__sep {
    color: var(--color-fg-muted);
    user-select: none;
  }

  /* ==========================================================================
     CircuitGrid
     ========================================================================== */
  .circuit-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 640px) {
    .circuit-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .circuit-grid {
      /* 3 columns × 2 rows for 5 circuits; the 6th cell stays empty on
         desktop so the first row reads as a "trio" of marquee circuits
         (Monaco / Barcelona / Monza — all-time staples) and the second
         row balances with Spa + Silverstone. */
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ---- Card --------------------------------------------------------------- */
  .circuit-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    background: var(--primary);
    border: var(--border-default);
    border-radius: var(--radius-md);
    text-align: left;
    cursor: pointer;
    color: inherit;
    font: inherit;
    transition:
      border-color var(--motion-duration-short) var(--motion-ease-out),
      transform var(--motion-duration-short) var(--motion-ease-out),
      background var(--motion-duration-short) var(--motion-ease-out),
      opacity var(--motion-duration-moderate) var(--motion-ease-out);
    opacity: 0;
    transform: translateY(8px);
  }

  .circuit-card[data-visible='true'] {
    opacity: 1;
    transform: translateY(0);
  }

  .circuit-card:hover,
  .circuit-card:focus-visible {
    border-color: var(--secondary);
    background: linear-gradient(180deg, var(--primary) 0%, var(--primary-2) 100%);
    transform: translateY(-2px);
    outline: none;
  }

  .circuit-card:focus-visible {
    box-shadow: 0 0 0 2px var(--secondary);
  }

  .circuit-card__svg-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 3;
    background: var(--ink);
    border-radius: var(--radius-sm);
    overflow: hidden;
    border: 1px solid rgba(33, 158, 188, 0.12);
  }

  .circuit-card__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  /* Animated dot — slight glow on hover */
  .circuit-card__dot {
    transition: filter var(--motion-duration-short) var(--motion-ease-out);
  }

  .circuit-card:hover .circuit-card__dot,
  .circuit-card:focus-visible .circuit-card__dot {
    filter: drop-shadow(0 0 4px var(--accent));
  }

  .circuit-card__halo {
    pointer-events: none;
  }

  /* ---- Meta row (name + country) ---------------------------------------- */
  .circuit-card__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .circuit-card__name {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    color: var(--color-fg);
    line-height: var(--leading-snug);
  }

  .circuit-card__country {
    font-family: var(--font-body);
    font-size: var(--text-xs);
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  /* ---- Stats row (revealed on hover) ------------------------------------- */
  .circuit-card__stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--rule);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      max-height var(--motion-duration-moderate) var(--motion-ease-out),
      opacity var(--motion-duration-short) var(--motion-ease-out);
  }

  .circuit-card__stats[data-visible='true'] {
    max-height: 80px;
    opacity: 1;
  }

  .circuit-card__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .circuit-card__stat-value {
    font-family: var(--font-display);
    font-size: var(--text-md);
    font-weight: 600;
    color: var(--color-highlight);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-snug);
    line-height: 1;
  }

  .circuit-card__stat-unit {
    font-family: var(--font-display);
    font-size: 10px;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
  }

  /* ==========================================================================
     CircuitModal
     ========================================================================== */
  .circuit-modal {
    position: fixed;
    inset: 0;
    z-index: var(--z-modal);
    background: rgba(10, 14, 20, 0.95);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-4);
    animation: circuit-modal-fade-in var(--motion-duration-moderate) var(--motion-ease-out);
  }

  @keyframes circuit-modal-fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .circuit-modal__panel {
    position: relative;
    width: 100%;
    max-width: 900px;
    background: var(--primary);
    border: var(--border-default);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    box-shadow: var(--shadow-lg);
    animation: circuit-modal-rise var(--motion-duration-moderate) var(--motion-ease-out);
  }

  @keyframes circuit-modal-rise {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .circuit-modal__close {
    position: absolute;
    top: var(--space-3);
    right: var(--space-3);
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: var(--color-fg-muted);
    border: 1px solid var(--rule);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition:
      color var(--motion-duration-short) var(--motion-ease-out),
      border-color var(--motion-duration-short) var(--motion-ease-out);
  }

  .circuit-modal__close:hover,
  .circuit-modal__close:focus-visible {
    color: var(--color-highlight);
    border-color: var(--color-highlight);
    outline: none;
  }

  .circuit-modal__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-right: var(--space-8);
  }

  .circuit-modal__kicker {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-brand);
  }

  .circuit-modal__title {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    color: var(--color-fg);
    line-height: var(--leading-tight);
    margin: 0;
  }

  .circuit-modal__stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
    gap: var(--space-4);
    margin: var(--space-3) 0 0;
  }

  .circuit-modal__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .circuit-modal__stat dt {
    font-family: var(--font-display);
    font-size: 10px;
    color: var(--color-fg-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
  }

  .circuit-modal__stat dd {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-md);
    color: var(--color-highlight);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-snug);
  }

  .circuit-modal__svg-wrap {
    width: 100%;
    aspect-ratio: 5 / 3;
    background: var(--ink);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .circuit-modal__svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .circuit-modal__scrub {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .circuit-modal__scrub-label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-brand);
  }

  .circuit-modal__checkpoint {
    color: var(--color-highlight);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-normal);
    text-transform: none;
  }

  .circuit-modal__scrub-range {
    width: 100%;
    appearance: none;
    background: transparent;
    cursor: pointer;
    height: 32px;
  }

  .circuit-modal__scrub-range::-webkit-slider-runnable-track {
    height: 4px;
    background: var(--rule-strong);
    border-radius: var(--radius-sm);
  }

  .circuit-modal__scrub-range::-moz-range-track {
    height: 4px;
    background: var(--rule-strong);
    border-radius: var(--radius-sm);
  }

  .circuit-modal__scrub-range::-webkit-slider-thumb {
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent);
    margin-top: -6px;
    box-shadow: 0 0 0 4px rgba(255, 183, 3, 0.15);
    transition: box-shadow var(--motion-duration-short) var(--motion-ease-out);
  }

  .circuit-modal__scrub-range::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(255, 183, 3, 0.15);
  }

  .circuit-modal__scrub-range:focus-visible::-webkit-slider-thumb {
    box-shadow: 0 0 0 4px rgba(255, 183, 3, 0.4);
  }

  .circuit-modal__scrub-axis {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-display);
    font-size: 10px;
    color: var(--color-fg-muted);
    letter-spacing: var(--tracking-wide);
  }

  /* ==========================================================================
     Responsive
     ========================================================================== */
  @media (max-width: 640px) {
    .sim-section {
      padding: var(--space-10) var(--space-4);
    }

    .circuit-modal__panel {
      padding: var(--space-4);
      max-height: calc(100vh - var(--space-8));
      overflow-y: auto;
    }

    .circuit-modal__stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
