---
/**
 * SimulationSection — Sección 02 del portfolio.
 *
 * El simulador entrena con UN único circuito simplificado, mostrado como
 * pieza central. El mismo trazado alimenta el bucle de perception → action
 * con:
 *   - 11 rayos sensor que detectan bordes y línea de meta
 *   - checkpoints auto-generados sobre el path
 *
 * El path SVG viene de `src/data/circuits/circuits.json` (mismo track data
 * que las versiones previas multi-circuito), pero **sin etiquetar** por
 * nombre — en esta sección es genéricamente "Circuito de entrenamiento"
 * para no distraer del aprendizaje.
 *
 * React island: `TrainingCircuit` (client:visible). Maneja dot animation,
 * ray rendering, scrub slider, pulsing checkpoints y medidas del path.
 */
import TrainingCircuit from '../interactive/TrainingCircuit';

interface Props {
  locale: 'es' | 'en';
}

const { locale } = Astro.props;

const content = {
  es: {
    kicker: '// 02 — SIMULACIÓN DEL CIRCUITO',
    titleLines: ['Circuito de entrenamiento,', 'once rayos sensor'],
    lead:
      'Un trazado simplificado para acelerar el aprendizaje del agente. Los checkpoints se generan automáticamente sobre el path a partir de los puntos cardinales de la curva. Once rayos sensor muestrean bordes y línea de meta en cada step a 50 Hz.',
    stats: [
      '1 circuito de entrenamiento',
      '11 rayos sensor',
      '50 Hz simulación',
      '16 puntos de interés',
      '98 generaciones',
    ],
  },
  en: {
    kicker: '// 02 — CIRCUIT SIMULATION',
    titleLines: ['Training circuit,', 'eleven sensor rays'],
    lead:
      'A simplified track to accelerate the agent\'s learning. Checkpoints are generated automatically along the path from the curve\'s cardinal points. Eleven sensor rays sample edges and finish line at 50 Hz on every simulation step.',
    stats: [
      '1 training circuit',
      '11 sensor rays',
      '50 Hz simulation',
      '16 reference points',
      '98 generations',
    ],
  },
}[locale];

const stats = content.stats;
---

<section id="simulation" class="sim-section" data-section="simulation" aria-labelledby="sim-title">
  <div class="sim-section__inner">
    <header class="sim-section__header">
      <span class="sim-section__kicker">{content.kicker}</span>
      <h2 id="sim-title" class="sim-section__title">
        {content.titleLines.map((line) => (
          <span class="sim-section__title-line">{line}</span>
        ))}
      </h2>
      <p class="sim-section__lead">{content.lead}</p>
    </header>

    <div class="sim-stats" role="list" aria-label={locale === 'es' ? 'Estadísticas del simulador' : 'Simulator stats'}>
      {stats.map((stat, idx) => (
        <span class="sim-stats__item" role="listitem">
          <span class="sim-stats__text">{stat}</span>
          {idx < stats.length - 1 && <span class="sim-stats__sep" aria-hidden="true">·</span>}
        </span>
      ))}
    </div>

    <TrainingCircuit client:visible locale={locale} />
  </div>
</section>

<style is:global>
  /* ==========================================================================
     SimulationSection — centered layout with a single training circuit
     as the visual centerpiece. All values come from tokens.css.
     ========================================================================== */

  .sim-section {
    position: relative;
    padding: var(--section-padding-y) var(--space-5);
    border-top: var(--border-thin);
    scroll-margin-top: 96px;
  }

  .sim-section__inner {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  /* ---- Header ------------------------------------------------------------- */
  .sim-section__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 880px;
  }

  .sim-section__kicker {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-brand);
  }

  .sim-section__title {
    font-family: var(--font-display);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    line-height: var(--leading-tight);
    color: var(--color-fg);
    margin: 0;
    font-size: clamp(1.75rem, 4vw, var(--text-2xl));
  }

  .sim-section__title-line {
    display: block;
  }

  .sim-section__lead {
    font-family: var(--font-body);
    font-size: var(--text-base);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
    max-width: 64ch;
  }

  @media (min-width: 768px) {
    .sim-section__lead {
      font-size: var(--text-md);
    }
  }

  /* ---- Stats panel -------------------------------------------------------- */
  .sim-stats {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    padding: var(--space-4) 0;
    border-top: var(--border-thin);
    border-bottom: var(--border-thin);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--color-fg);
  }

  .sim-stats__item {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .sim-stats__text {
    font-weight: 500;
  }

  .sim-stats__sep {
    color: var(--color-fg-muted);
    user-select: none;
  }

  /* ==========================================================================
     TrainingCircuit
     Centered hero — the SVG sits in a card with HUD stats below.
     ========================================================================== */
  .training-circuit {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    width: 100%;
    max-width: 980px;
    margin: var(--space-6) auto 0;
    padding: var(--space-6);
    background: linear-gradient(180deg, var(--primary) 0%, var(--primary-2) 200%);
    border: var(--border-default);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
  }

  .training-circuit__svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
    /* No background — the SVG sits on top of the card so the gradients
       and grid are visible through the empty racing surface */
  }

  .training-circuit__hud {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    padding: var(--space-4) var(--space-3);
    background: var(--ink);
    border: 1px solid var(--rule);
    border-radius: var(--radius-md);
  }

  @media (min-width: 640px) {
    .training-circuit__hud {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .training-circuit__stat {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .training-circuit__stat-value {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 1;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    letter-spacing: var(--tracking-snug);
  }

  .training-circuit__stat-label {
    font-family: var(--font-display);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--text-dim);
    line-height: 1.3;
  }

  .training-circuit__scrub {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .training-circuit__scrub-label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-brand);
  }

  .training-circuit__scrub-pos {
    color: var(--accent);
    font-variant-numeric: tabular-nums;
    text-transform: none;
    letter-spacing: var(--tracking-normal);
  }

  .training-circuit__scrub-range {
    width: 100%;
    appearance: none;
    background: transparent;
    cursor: pointer;
    height: 28px;
  }

  .training-circuit__scrub-range::-webkit-slider-runnable-track {
    height: 4px;
    background: var(--rule-strong);
    border-radius: var(--radius-sm);
  }

  .training-circuit__scrub-range::-moz-range-track {
    height: 4px;
    background: var(--rule-strong);
    border-radius: var(--radius-sm);
  }

  .training-circuit__scrub-range::-webkit-slider-thumb {
    appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent);
    margin-top: -6px;
    box-shadow: 0 0 0 4px rgba(255, 91, 58, 0.18);
    transition: box-shadow var(--motion-duration-short) var(--motion-ease-out);
  }

  .training-circuit__scrub-range::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border: 0;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(255, 91, 58, 0.18);
  }

  .training-circuit__scrub-range:focus-visible::-webkit-slider-thumb {
    box-shadow: 0 0 0 4px rgba(255, 91, 58, 0.4);
  }

  .training-circuit__scrub-axis {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-display);
    font-size: 11px;
    color: var(--text-dim);
    letter-spacing: var(--tracking-wide);
  }

  .training-circuit__caption {
    font-family: var(--font-display);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--text-dim);
    margin: 0;
    line-height: 1.4;
    text-align: center;
  }

  /* ==========================================================================
     Responsive
     ========================================================================== */
  @media (max-width: 640px) {
    .sim-section {
      padding: var(--space-10) var(--space-4);
    }

    .training-circuit {
      padding: var(--space-4);
      gap: var(--space-4);
    }

    .training-circuit__hud {
      padding: var(--space-3);
    }
  }
</style>
