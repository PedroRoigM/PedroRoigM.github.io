---
/**
 * Nav — Sticky navigation handled by `NavMenu` (React island).
 *
 * The NavMenu owns:
 *   - Desktop nav (brand + inline section links + language switcher)
 *   - Mobile hamburger menu (collapses section links + language switcher
 *     into a slide-down panel on viewports <900 px)
 *
 * The previous Astro-only nav pushed the ES/EN toggle into the same flex
 * row as the section links, which overflowed the page on phones and made
 * horizontal scroll appear across every section. The hamburger fixes that.
 */
import NavMenu from './NavMenu';

interface Props {
  locale?: 'es' | 'en';
}

const { locale = 'es' } = Astro.props;
---

<NavMenu client:load locale={locale} />
