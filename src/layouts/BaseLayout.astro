---
/**
 * BaseLayout — Wrapper global.
 * - Carga fuentes auto-hospedadas
 * - Aplica tokens, reset y typography
 * - Monta GrainOverlay
 * - Monta LenisProvider (cliente, client:load)
 * - Meta tags SEO base
 */
import '@fontsource-variable/inter';
import '@fontsource-variable/geist-mono';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/typography.css';
import GrainOverlay from '../components/global/GrainOverlay.astro';
import LenisProvider from '../components/global/LenisProvider';
import Nav from '../components/global/Nav.astro';

interface Props {
  title: string;
  description: string;
  locale: 'es' | 'en';
  /** Optional canonical URL override */
  canonical?: string;
}

const { title, description, locale, canonical } = Astro.props;
const canonicalUrl =
  canonical ??
  new URL(Astro.url.pathname, Astro.site ?? 'https://pedro-roig-morera.dev').toString();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale === 'es' ? 'es_ES' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Theme color -->
    <meta name="theme-color" content="#0b0c10" />
  </head>
  <body>
    <GrainOverlay />
    <Nav locale={locale} />
    <main id="main-content">
      <slot />
    </main>

    <LenisProvider client:load />

    <style is:global>
      /* Page-level ambient background — gradient subtle on body */
      body {
        background:
          radial-gradient(
            ellipse 80% 60% at 50% 0%,
            rgba(168, 216, 0, 0.10) 0%,
            transparent 50%
          ),
          linear-gradient(180deg, var(--ink) 0%, var(--ink-2) 100%);
        background-attachment: fixed;
      }

      /* ================================================================
       * Animated section dividers — every <section data-section> gets a
       * thin brand-tinted line that draws from left to right when the
       * section scrolls into the viewport. We do this via a pseudo
       * element instead of the static border-top so the existing
       * components don't need to be touched.
       *
       * Effect stays subtle (1px, ~600ms ease-out) so it doesn't
       * compete with the section content. Reduced-motion: skip the
       * animation and show the line statically.
       * ================================================================ */
      [data-section] {
        position: relative;
      }
      [data-section]::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent 0%,
          var(--rule) 8%,
          var(--color-brand) 50%,
          var(--rule) 92%,
          transparent 100%
        );
        transform: scaleX(0);
        transform-origin: left center;
        transition: transform 700ms cubic-bezier(0.2, 0.9, 0.3, 1) 80ms;
        pointer-events: none;
        z-index: 1;
      }
      [data-section].is-divided::before {
        transform: scaleX(1);
      }
      @media (prefers-reduced-motion: reduce) {
        [data-section]::before {
          transform: scaleX(1);
          transition: none;
        }
      }
    </style>

    <script>
      /**
       * Section divider draw-in — single global observer. When any
       * <section data-section> enters the viewport, we add .is-divided
       * which triggers the CSS transition on its ::before. We only
       * need to run once per section (unobserve after first hit) so
       * the work stays cheap on long pages.
       */
      const initSectionDividers = () => {
        const sections = document.querySelectorAll<HTMLElement>('[data-section]');
        if (sections.length === 0) return;
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-divided');
              observer.unobserve(entry.target);
            }
          },
          { threshold: 0.05, rootMargin: '0px 0px -8% 0px' }
        );
        sections.forEach((s) => observer.observe(s));
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initSectionDividers, { once: true });
      } else {
        initSectionDividers();
      }
    </script>
  </body>
</html>
