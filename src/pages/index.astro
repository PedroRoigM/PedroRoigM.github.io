---
/**
 * Homepage — "Acerca de mí".
 *
 * Estructura (de arriba a abajo):
 *   1. Hero          — nombre, rol, lede (la frase del motor/datos), chips meta
 *   2. Acerca de     — bio corta + idiomas
 *   3. Ahora         — el TFG de F1 como card destacada → /f1
 *   4. Trayectoria   — timeline vertical con experiencia + educación
 *   5. Skills        — hard skills (chips) + soft skills (lista)
 *   6. CTA           — "Hablamos" → /contact
 *
 * Animaciones: se reutiliza el patrón `.reveal` + IntersectionObserver
 * que ya usan las secciones de F1 (fade + translateY 20→0, stagger vía
 * `--reveal-delay`). El hero tiene una entrada un pelín más larga
 * (split por líneas, duración hero).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/global/Footer.astro';

const locale = 'es' as const;

const content = {
