  .home__hero-meta {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  /* ============================================================
     Chip (hero meta + skills)
     ============================================================ */
