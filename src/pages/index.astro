    font-size: var(--text-md);
    color: var(--color-brand);
    margin: 0;
  }

  .home__now-body {
    font-family: var(--font-body);
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-fg-muted);
    margin: 0 0 var(--space-5);
    max-width: 64ch;
  }

  .home__now-tags {
