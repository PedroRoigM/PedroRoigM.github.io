---
/**
 * Homepage — placeholder.
 *
 * El portfolio principal vive ahora en /f1 (TFG: Sistema Multi-Agente para F1).
 * Esta página será reemplazada próximamente con un "acerca de mí" + highlights.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/global/Footer.astro';

const locale = 'es' as const;
---

<BaseLayout
  title="Pedro Roig Morera"
  description="Portfolio personal — próximamente."
  locale={locale}
>
  <section class="home-placeholder">
    <div class="home-placeholder__inner">
      <p class="home-placeholder__eyebrow">PR</p>
      <h1 class="home-placeholder__title">Pedro Roig Morera</h1>
      <p class="home-placeholder__lede">
        Esta página está en construcción. Mientras tanto, puedes ver mi
        <a href="/f1">TFG: Sistema Multi-Agente para F1</a>.
      </p>
    </div>
  </section>

  <Footer locale={locale} />
</BaseLayout>

<style>
  .home-placeholder {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-12) var(--space-5);
  }
  .home-placeholder__inner {
    max-width: 560px;
    text-align: center;
  }
  .home-placeholder__eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-brand);
    margin-bottom: var(--space-4);
  }
  .home-placeholder__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    color: var(--color-fg);
    margin: 0 0 var(--space-4);
  }
  .home-placeholder__lede {
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-fg-muted);
    line-height: 1.6;
  }
  .home-placeholder__lede a {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .home-placeholder__lede a:hover {
    color: var(--color-fg);
  }
</style>
