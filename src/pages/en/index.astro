<script>
  // Same reveal + hero entrance pattern as src/pages/index.astro. Kept inline
  // so each locale page is self-contained; the duplication is intentional.
  const initHero = () => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) {
      document.querySelectorAll('.hero-reveal').forEach((el) => {
        (el as HTMLElement).style.opacity = '1';
        (el as HTMLElement).style.transform = 'none';
      });
      return;
    }
    requestAnimationFrame(() => {
      document.querySelectorAll('.hero-reveal').forEach((el) => {
        const delay = parseFloat((el as HTMLElement).style.getPropertyValue('--hero-delay')) || 0;
        window.setTimeout(() => el.classList.add('is-hero-visible'), delay);
      });
    });
  };

  const initReveals = () => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const reveals = document.querySelectorAll<HTMLElement>('.home .reveal');
    if (reducedMotion) {
      reveals.forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const target = entry.target as HTMLElement;
          const delayVar = parseFloat(target.style.getPropertyValue('--reveal-delay')) || 0;
          window.setTimeout(() => target.classList.add('is-visible'), delayVar);
          observer.unobserve(target);
        }
      },
      { threshold: 0.15, rootMargin: '0px 0px -6% 0px' }
    );
    reveals.forEach((el) => observer.observe(el));
  };

  const init = () => {
    initHero();
    initReveals();
    initSpotlight();
    initMagnetic();
    initCountUp();
  };

  /** Spotlight + 3D tilt + glare — see ES version for the full rationale. */
  const initSpotlight = () => {
    const cards = document.querySelectorAll<HTMLElement>('.home__tfg-stat');
    if (cards.length === 0) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) return;
    const supportsHover = window.matchMedia('(hover: hover)').matches;
    if (!supportsHover) return;
    cards.forEach((card) => {
      let pendingX = 0;
      let pendingY = 0;
      let frameRequested = false;
      const flush = () => {
        const rect = card.getBoundingClientRect();
        const localX = pendingX - rect.left;
        const localY = pendingY - rect.top;
        card.style.setProperty('--spot-x', `${localX}px`);
        card.style.setProperty('--spot-y', `${localY}px`);
        const pctX = Math.max(0, Math.min(100, (localX / rect.width) * 100));
        card.style.setProperty('--glare-x', `${pctX}%`);
        const tiltX = ((localY / rect.height) - 0.5) * -8;
        const tiltY = ((localX / rect.width) - 0.5) * 8;
        card.style.transform =
          `perspective(900px) rotateX(${tiltX}deg) rotateY(${tiltY}deg) translateY(-2px)`;
        frameRequested = false;
      };
      card.addEventListener('pointermove', (e) => {
        pendingX = e.clientX;
        pendingY = e.clientY;
        if (!frameRequested) {
          frameRequested = true;
          requestAnimationFrame(flush);
        }
      });
      card.addEventListener('pointerleave', () => {
        card.style.transform = '';
        card.style.setProperty('--glare-x', '');
      });
    });
  };

  /** Magnetic button — see ES version for the rationale. */
  const initMagnetic = () => {
    const buttons = document.querySelectorAll<HTMLElement>('[data-magnetic]');
    if (buttons.length === 0) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reducedMotion) return;
    const supportsHover = window.matchMedia('(hover: hover)').matches;
    if (!supportsHover) return;
    buttons.forEach((btn) => {
      const strength = btn.dataset.magnetic === 'strong' ? 0.25 : 0.15;
      let pendingX = 0;
      let pendingY = 0;
      let frameRequested = false;
      const flush = () => {
        btn.style.transform = `translate(${pendingX}px, ${pendingY}px)`;
        frameRequested = false;
      };
      btn.addEventListener('pointermove', (e) => {
        const rect = btn.getBoundingClientRect();
        pendingX = (e.clientX - rect.left - rect.width / 2) * strength;
        pendingY = (e.clientY - rect.top - rect.height / 2) * strength;
        if (!frameRequested) {
          frameRequested = true;
          requestAnimationFrame(flush);
        }
      });
      btn.addEventListener('pointerleave', () => {
        btn.style.transform = '';
      });
    });
  };

  /** Count-up — see ES version for the rationale. */
  const initCountUp = () => {
    const counters = document.querySelectorAll<HTMLElement>('[data-count-up]');
    if (counters.length === 0) return;
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const animate = (el: HTMLElement) => {
      const target = parseFloat(el.dataset.countUp || '0');
      const decimals = parseInt(el.dataset.countUpDecimals || '0', 10);
      const suffix = el.dataset.countUpSuffix || '';
      if (reducedMotion || isNaN(target)) {
        el.textContent = target.toFixed(decimals) + suffix;
        return;
      }
      const duration = 1200;
      const start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / duration);
        const eased = 1 - Math.pow(1 - t, 3);
        const value = target * eased;
        el.textContent = value.toFixed(decimals) + suffix;
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          animate(entry.target as HTMLElement);
          observer.unobserve(entry.target);
        }
      },
      { threshold: 0.4, rootMargin: '0px 0px -10% 0px' }
    );
    counters.forEach((c) => observer.observe(c));
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init, { once: true });
  } else {
    init();
  }
</script>

<style>
  /* Identical visual styles as the ES version — duplicated for page
