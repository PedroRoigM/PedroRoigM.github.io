---
/**
 * /contact — Página de contacto (placeholder).
 *
 * Se irá ampliando con formulario, redes, etc. Por ahora deja los canales
 * básicos para mantener la nav funcional.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/global/Footer.astro';

const locale = 'es' as const;
---

<BaseLayout
  title="Contacto — Pedro Roig Morera"
  description="Cómo contactar conmigo."
  locale={locale}
>
  <section class="contact-placeholder">
    <div class="contact-placeholder__inner">
      <p class="contact-placeholder__eyebrow">Contacto</p>
      <h1 class="contact-placeholder__title">Hablemos</h1>
      <p class="contact-placeholder__lede">
        Página en construcción. Mientras tanto, puedes escribirme a
        <a href="mailto:pedro.roig.morera@gmail.com">pedro.roig.morera@gmail.com</a>.
      </p>
    </div>
  </section>

  <Footer locale={locale} />
</BaseLayout>

<style>
  .contact-placeholder {
    min-height: calc(100vh - 200px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-12) var(--space-5);
  }
  .contact-placeholder__inner {
    max-width: 560px;
    text-align: center;
  }
  .contact-placeholder__eyebrow {
    display: inline-block;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    text-transform: uppercase;
    letter-spacing: var(--tracking-widest);
    color: var(--color-brand);
    margin-bottom: var(--space-4);
  }
  .contact-placeholder__title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 600;
    letter-spacing: var(--tracking-snug);
    color: var(--color-fg);
    margin: 0 0 var(--space-4);
  }
  .contact-placeholder__lede {
    font-family: var(--font-body);
    font-size: var(--text-md);
    color: var(--color-fg-muted);
    line-height: 1.6;
  }
  .contact-placeholder__lede a {
    color: var(--color-brand);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .contact-placeholder__lede a:hover {
    color: var(--color-fg);
  }
</style>
